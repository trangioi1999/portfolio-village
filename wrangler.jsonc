{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-village",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/portfolio-village/browser",
    // Serve index.html for unknown paths so Angular routes work on refresh
    "not_found_handling": "single-page-application"
  }
}
